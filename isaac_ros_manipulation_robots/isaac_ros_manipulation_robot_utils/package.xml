<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaac_ros_manipulation_robot_utils</name>
  <version>5.0.0</version>
  <description>Robot utilities used across Isaac Manipulator</description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>NVIDIA Isaac ROS Software License</license>
  <url type="website">https://developer.nvidia.com/isaac-ros-gems/</url>
  <author>Karanbir Chahal</author>

  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>isaac_ros_launch_utils</depend>
  <depend>isaac_ros_manipulation_interfaces</depend>
  <depend>isaac_ros_manipulation_ros_python_utils</depend>
  <depend>isaac_ros_test</depend>
  <depend>xacro</depend>
  <depend>moveit_configs_utils</depend>
  <depend>python3-matplotlib</depend>

  <build_depend>isaac_ros_common</build_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>